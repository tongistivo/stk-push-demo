# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# Placeholders only: nothing below is a real credential.

# ---- Daraja SANDBOX credentials (developer.safaricom.co.ke -> My Apps) ----
DARAJA_CONSUMER_KEY=your-sandbox-consumer-key
DARAJA_CONSUMER_SECRET=your-sandbox-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-sandbox-passkey

# ---- Callback ----
# A long random secret that only you and Daraja's URL know. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLBACK_TOKEN=replace-with-a-long-random-string-at-least-24-chars
# Must be https, and must END with /api/callback/ followed by CALLBACK_TOKEN.
# Local testing with a tunnel:  https://<your-tunnel-host>/api/callback/<CALLBACK_TOKEN>
# On Render:                    https://<your-service>.onrender.com/api/callback/<CALLBACK_TOKEN>
DARAJA_CALLBACK_URL=https://your-host.example/api/callback/replace-with-the-same-token

# ---- Database ----
# Leave empty for local development (uses a local SQLite file).
# On Render, paste your Neon connection string here (set it in the Render dashboard).
DATABASE_URL=

# ---- App behaviour ----
# "development" locally. Render sets "production" for you via render.yaml.
APP_ENV=development
# Largest amount (KSh) the demo accepts.
MAX_AMOUNT=1000
# Optional: comma-separated CIDR list to accept callbacks from. Leave empty to disable.
CALLBACK_ALLOWED_IPS=
# Number of proxies in front of the app (Render: 1). Used for rate limiting.
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=INFO
